# #################################################################
# NiaKylie Frontend - Production .gitignore
# #################################################################

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Production & Development Build Artifacts ──
dist/
dist-ssr/
build/
.next/
out/

# ── Environment & Secret Keys ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ── Vite / Bundler Cache ──
.vite/
.cache/
.eslintcache
*.tsbuildinfo

# ── Logs & Debug Output ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Temporary & Scratch Files ──
scratch_*
*.tmp

# ── IDE & Editor Settings ──
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Operating System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
